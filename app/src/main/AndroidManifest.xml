<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Storage -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Overlay window -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Services and notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network — required for Supabase and license verification -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Query installed apps -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VCam"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true">

        <!-- LOGIN — this is the LAUNCHER activity (replaces CodeActivity as entry point) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- REGISTER -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <!-- CODE activity kept for backward compatibility (no longer launcher) -->
        <activity
            android:name=".ui.CodeActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- MAIN app screen -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Source selection after authentication -->
        <activity
            android:name=".ui.SourceModeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <!-- OBS / Bridg USB stream setup -->
        <activity
            android:name=".ui.ObsBridgeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <!-- ACCOUNT -->
        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <!-- SUBSCRIPTION PLANS -->
        <activity
            android:name=".ui.account.SubscriptionPlansActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- PAYMENT -->
        <activity
            android:name=".ui.account.PaymentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <!-- ADMIN DASHBOARD -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ADMIN: Subscription Requests -->
        <activity
            android:name=".ui.admin.AdminSubscriptionRequestsActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ADMIN: Users -->
        <activity
            android:name=".ui.admin.AdminUsersActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ADMIN: Payment Methods -->
        <activity
            android:name=".ui.admin.AdminPaymentMethodsActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ADMIN: Stats -->
        <activity
            android:name=".ui.admin.AdminStatsActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- Media preview as floating dialog popup -->
        <activity
            android:name=".ui.PreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.VCam.Dialog"
            android:windowSoftInputMode="stateHidden"/>

        <!-- Main injection service -->
        <service
            android:name=".service.VCamService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Floating overlay window service -->
        <service
            android:name=".service.FloatWindowService"
            android:exported="false" />

    </application>

</manifest>
