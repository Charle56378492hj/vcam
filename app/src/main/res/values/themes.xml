<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VCam" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary_brand</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_primary_brand</item>
        <item name="android:windowBackground">@color/color_bg_light</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialCardViewStyle">@style/CardView.Material</item>
    </style>

    <style name="CardView.Material" parent="Widget.MaterialComponents.CardView">
        <item name="android:checkable">true</item>
        <item name="checkedIconTint">@color/color_primary_brand</item>
    </style>

    <!-- Floating dialog theme for PreviewActivity -->
    <style name="Theme.VCam.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/color_primary_brand</item>
        <item name="colorAccent">@color/color_primary_brand</item>
        <item name="android:windowBackground">@drawable/bg_preview_dialog</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">95%</item>
        <item name="android:windowMinWidthMinor">95%</item>
    </style>
</resources>
