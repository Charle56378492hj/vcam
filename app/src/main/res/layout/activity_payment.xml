<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:title="إتمام الدفع"
        app:titleTextColor="@color/color_text_dark"
        app:navigationIconTint="@color/color_text_dark"
        android:elevation="2dp"/>

    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:indeterminateTint="@color/color_primary_brand"
        android:visibility="gone" android:layout_gravity="center"
        android:layout_marginTop="24dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Plan Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/color_primary_brand"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="الباقة المختارة" android:textSize="13sp"
                        android:textColor="#99FFFFFF"/>
                    <TextView android:id="@+id/tv_selected_plan"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/white" android:layout_marginTop="4dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <TextView android:id="@+id/tv_selected_duration"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textSize="14sp"
                            android:textColor="#CCFFFFFF"/>
                        <TextView android:id="@+id/tv_selected_price"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="20sp" android:textStyle="bold"
                            android:textColor="@color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Payment Methods -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="اختر طريقة الدفع"
                android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/color_text_dark"
                android:layout_marginBottom="10dp"/>

            <TextView android:id="@+id/tv_no_methods"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="لا توجد طرق دفع متاحة حالياً"
                android:gravity="center" android:textSize="14sp"
                android:textColor="@color/color_text_medium"
                android:visibility="gone" android:paddingBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_methods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp"/>

            <!-- Payment Details Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_payment_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="تعليمات الدفع"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/color_text_dark"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="المبلغ المطلوب:" android:textColor="@color/color_text_medium"
                            android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_payment_amount"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textColor="@color/color_primary_brand"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="عنوان الإرسال:" android:textColor="@color/color_text_medium"
                            android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_payment_address"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textColor="@color/color_text_dark"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_border" android:layout_marginVertical="12dp"/>

                    <TextView android:id="@+id/tv_payment_instructions"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/color_text_medium" android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="رقم عملية التحويل"
                        android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/color_text_medium"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/color_border">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_transaction_number"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="أدخل رقم العملية هنا"
                            android:inputType="text" android:textSize="15sp"
                            android:textColor="@color/color_text_dark"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom submit bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        android:orientation="vertical"
        android:elevation="4dp">

        <ProgressBar android:id="@+id/progress_submit"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:indeterminateTint="@color/color_primary_brand"
            android:visibility="gone" android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="إرسال طلب الاشتراك"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/color_primary_brand"/>

    </LinearLayout>

</LinearLayout>
