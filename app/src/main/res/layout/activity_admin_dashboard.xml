<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_primary_brand"
        app:title="لوحة الإدارة"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white"
        android:elevation="4dp"/>

    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:indeterminateTint="@color/color_primary_brand"
        android:visibility="gone" android:layout_gravity="center"
        android:layout_marginTop="24dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Quick Stats Row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <TextView android:id="@+id/tv_total_users"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="28sp" android:textStyle="bold"
                            android:textColor="@color/color_primary_brand"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="المستخدمون" android:textSize="11sp"
                            android:textColor="@color/color_text_medium"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <TextView android:id="@+id/tv_active_subs"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="28sp" android:textStyle="bold"
                            android:textColor="@color/color_success"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="اشتراكات نشطة" android:textSize="11sp"
                            android:textColor="@color/color_text_medium"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <TextView android:id="@+id/tv_pending_requests"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="28sp" android:textStyle="bold"
                            android:textColor="@color/color_warning"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="طلبات معلقة" android:textSize="11sp"
                            android:textColor="@color/color_text_medium"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <TextView android:id="@+id/tv_total_revenue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="$0" android:textSize="22sp" android:textStyle="bold"
                            android:textColor="@color/color_success"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="إجمالي الإيرادات" android:textSize="11sp"
                            android:textColor="@color/color_text_medium"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Nav Cards -->
            <androidx.cardview.widget.CardView android:id="@+id/card_requests"
                android:layout_width="match_parent" android:layout_height="72dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="طلبات الاشتراك"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/color_text_dark"/>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/color_primary_brand"
                        android:contentDescription="Arrow"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/card_users"
                android:layout_width="match_parent" android:layout_height="72dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="إدارة المستخدمين"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/color_text_dark"/>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/color_primary_brand"
                        android:contentDescription="Arrow"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/card_payments"
                android:layout_width="match_parent" android:layout_height="72dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="طرق الدفع والباقات"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/color_text_dark"/>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/color_primary_brand"
                        android:contentDescription="Arrow"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/card_stats"
                android:layout_width="match_parent" android:layout_height="72dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الإحصائيات التفصيلية"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/color_text_dark"/>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/color_primary_brand"
                        android:contentDescription="Arrow"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
