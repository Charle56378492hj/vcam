<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_primary_brand"
        app:title="الإحصائيات"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white"
        android:elevation="4dp"/>

    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:indeterminateTint="@color/color_primary_brand"
        android:visibility="gone" android:layout_gravity="center"
        android:layout_marginTop="32dp"/>

    <androidx.core.widget.NestedScrollView android:id="@+id/content_layout"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Stats Grid -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="20dp">
                        <TextView android:id="@+id/tv_total_users"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="@color/color_primary_brand"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="إجمالي المستخدمين" android:textSize="12sp"
                            android:textColor="@color/color_text_medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="20dp">
                        <TextView android:id="@+id/tv_active_subs"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="@color/color_success"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="اشتراكات نشطة" android:textSize="12sp"
                            android:textColor="@color/color_text_medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="20dp">
                        <TextView android:id="@+id/tv_pending_requests"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="@color/color_warning"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="طلبات معلقة" android:textSize="12sp"
                            android:textColor="@color/color_text_medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="20dp">
                        <TextView android:id="@+id/tv_total_revenue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="$0" android:textSize="24sp" android:textStyle="bold"
                            android:textColor="@color/color_success"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="إجمالي الإيرادات" android:textSize="12sp"
                            android:textColor="@color/color_text_medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="20dp">
                        <TextView android:id="@+id/tv_banned_users"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="@color/color_error"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="محظورون" android:textSize="12sp"
                            android:textColor="@color/color_text_medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="20dp">
                        <TextView android:id="@+id/tv_total_requests"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="@color/color_text_dark"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="طلبات مقبولة" android:textSize="12sp"
                            android:textColor="@color/color_text_medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="تحديث الإحصائيات"
                android:textSize="15sp" android:textColor="@color/white"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/color_primary_brand"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
