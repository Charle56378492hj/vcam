<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="@color/white"
        android:elevation="3dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_log_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="رجوع"
            android:textSize="12sp"
            android:textColor="@color/color_primary_brand"
            android:backgroundTint="@color/color_primary_light"
            app:cornerRadius="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="السجل"
            android:textColor="@color/color_text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:text="السجل محفوظ محلياً. يتضمن أحداث التطبيق وأوامر root وسجلات الكاميرا عند توفر root."
        android:textColor="@color/color_text_hint"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_log_copy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="نسخ السجل"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/color_primary_brand"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_log_clear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="مسح السجل القديم"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/color_error"
            android:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            app:strokeColor="@color/color_error"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_log_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/color_text_dark"
            android:textIsSelectable="true"
            android:textSize="10sp"
            android:text="لا توجد سجلات بعد" />
    </ScrollView>
</LinearLayout>
